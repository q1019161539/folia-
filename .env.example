# 复制为 .env 后填写。不要提交真实密码或 API Key。
STUDIO_PASSWORD=replace-with-a-long-random-password
# 分享版默认不提交真实稿件；确认账号、模板、路径和费用后再设为 1。
AUTO_PUBLISH_ENABLED=0

# AI 封面：按自己的服务协议与账号配置。Key 留空，不随源码分发。
COVER_API_BASE_URL=https://your-image-service.example/v1
COVER_API_KEY=
COVER_API_PROXY=
COVER_PRIMARY_PROVIDER=gpt
COVER_FALLBACK_ENABLED=0
COVER_FALLBACK_BASE_URL=https://your-image-service.example/v1
COVER_FALLBACK_MODEL=gemini-3-pro-image-preview
COVER_FALLBACK_API_KEY=
COVER_FALLBACK_PROXY=
COVER_REFERENCE_CONFIG=

# 标题及整场判歌。请求模型名不证明服务实际后端或计费。
TITLE_API_BASE_URL=https://your-text-service.example/v1
TITLE_API_MODEL=gpt-6.1-sol
TITLE_API_KEY=
TITLE_API_PROXY=
SONG_ANALYSIS_MODEL=gpt-6.1-sol
SONG_ANALYSIS_TIMEOUT_SECONDS=600

# BililiveTool 自己管理 B 站登录，Folia 不保存 B 站 Cookie。
BILILIVETOOL_BASE_URL=http://host.docker.internal:2333/api
BILILIVETOOL_PASSKEY=
BILILIVETOOL_UID=0
BILILIVETOOL_PRESET_ID=

# 可选云识别、备用判歌与身份复核。
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选：歌曲身份第二意见（ACRCloud 听歌识曲，仅在 Shazam 命中的候选歌词池整体
# 质量存疑时才会调用一次）。留空则这条路径整个跳过，行为等同于没有这个功能。
# 去 console.acrcloud.cn 建一个 "Audio & Video Recognition" 项目即可拿到这三项。
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_HOST=
